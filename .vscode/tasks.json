{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Backend: Build & Test",
            "type": "shell",
            "command": "mvn test",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "group": "build",
            "problemMatcher": ["$maven"]
        },
        {
            "label": "Backend: Run Spring Boot",
            "type": "shell",
            "command": "mvn spring-boot:run",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Frontend: Dev Server",
            "type": "shell",
            "command": "npm.cmd run dev",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Frontend: Build Production",
            "type": "shell",
            "command": "npm.cmd run build",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "group": "build",
            "problemMatcher": []
        }
    ]
}

