# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/road_maintenance_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=

# Gmail SMTP Email Configuration (for OTP verification)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_FROM=your_gmail_address@gmail.com

# Administrator Provisioning Key
ADMIN_SECRET_KEY=AdminSecureSetupKey2026

# Google Maps JavaScript API Key (frontend)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Frontend API Base URL
VITE_API_BASE_URL=http://localhost:8080/api
